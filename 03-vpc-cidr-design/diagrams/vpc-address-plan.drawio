          <mxGeometry x="850" y="800" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="title" value="VPC address plan&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal&quot;&gt;Three tiers in each of three Availability Zones, sized by need&lt;/span&gt;" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;div&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Legend&lt;/b&gt;&lt;/div&gt;&lt;b&gt;Address plan:&lt;/b&gt;&lt;ul style=&quot;padding-left:20px;margin-top:6px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;VPC &lt;font color=&quot;#5A6C86&quot; style=&quot;white-space:nowrap&quot;&gt;10.30.0.0/16&lt;/font&gt;: 65,536 addresses.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;3 tiers x 3 Availability Zones = 9 subnets, 16,128 addresses (25%).&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Free for new tiers: &lt;font color=&quot;#5A6C86&quot; style=&quot;white-space:nowrap&quot;&gt;10.30.63.0/24&lt;/font&gt;, &lt;font color=&quot;#5A6C86&quot; style=&quot;white-space:nowrap&quot;&gt;10.30.64.0/18&lt;/font&gt;, &lt;font color=&quot;#5A6C86&quot; style=&quot;white-space:nowrap&quot;&gt;10.30.128.0/17&lt;/font&gt;.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Sizing:&lt;/b&gt;&lt;ul style=&quot;padding-left:20px;margin-top:6px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Public /24&lt;/b&gt;: load balancer and NAT gateway interfaces only.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;App /20&lt;/b&gt;: instances, containers and Lambda interfaces each take an address.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Data /22&lt;/b&gt;: database nodes, replicas and interface endpoints.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Rules applied:&lt;/b&gt;&lt;ul style=&quot;padding-left:20px;margin-top:6px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;AWS reserves 5 addresses in every subnet (network, router, DNS, future use, broadcast).&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;A subnet lives in one Availability Zone, so every tier is repeated per zone.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Subnets must be /16 to /28.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;The VPC avoids on-premises &lt;font color=&quot;#5A6C86&quot; style=&quot;white-space:nowrap&quot;&gt;10.0.0.0/16&lt;/font&gt; and &lt;font color=&quot;#5A6C86&quot; style=&quot;white-space:nowrap&quot;&gt;172.16.0.0/12&lt;/font&gt;, so a VPN or Direct Connect link can route to both.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Availability Zone c is allocated now and left empty, so adding a third zone never means renumbering.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="120" width="420" height="810" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
